# Roads and railways (dromonyms) in Russia from Wikidata, CC0.
# P31: road Q34442 (no sitelink filter), railway Q728937 with ruwiki sitelink.
# P17 = Russia (Q159). Not the official federal highway list (ПП № 928) and not OSM.
# seed_dromonyms.py runs this once per VALUES type. Do not vendor SPARQL JSON/CSV.

SELECT DISTINCT ?item ?type ?ru ?en ?lat ?lon ?gn ?oktmo ?located ?iso ?dissolved ?replaced WHERE {
  VALUES ?type { wd:Q34442 wd:Q728937 }
  ?item wdt:P31 ?type .
  ?item wdt:P17 wd:Q159 .
  ?item rdfs:label ?ru FILTER(LANG(?ru) = "ru")
  OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en) = "en") }
  OPTIONAL { ?item p:P625/psv:P625 [ wikibase:geoLatitude ?lat; wikibase:geoLongitude ?lon ] }
  OPTIONAL { ?item wdt:P1566 ?gn }
  OPTIONAL { ?item wdt:P764 ?oktmo }
  OPTIONAL { ?item wdt:P131 ?located }
  OPTIONAL { ?located wdt:P300 ?iso FILTER(STRSTARTS(?iso, "RU-")) }
  OPTIONAL { ?item wdt:P576 ?dissolved }
  OPTIONAL { ?item wdt:P1366 ?replaced }
  FILTER(?type != wd:Q728937 || EXISTS {
    ?sitelink schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> .
  })
}

# Parent hop for items whose P131 is not in curated regions/cities.
