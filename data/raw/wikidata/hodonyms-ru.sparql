# Hodonyms (streets) in Russia from Wikidata, CC0.
# P31 in mapped types: street Q79007, boulevard Q54114, avenue Q628179,
# lane Q1251403, quay Q537127. P17 = Russia (Q159). Squares (Q174782) excluded.
# Coverage is Wikidata only — not FIAS/GAR and not every street of Russia.
# seed_hodonyms.py runs this once per VALUES type. Do not vendor SPARQL JSON/CSV.

SELECT DISTINCT ?item ?ru ?en ?lat ?lon ?gn ?located ?iso WHERE {
  VALUES ?type { wd:Q79007 wd:Q54114 wd:Q628179 wd:Q1251403 wd:Q537127 }
  ?item wdt:P31 ?type .
  ?item wdt:P17 wd:Q159 .
  ?item rdfs:label ?ru FILTER(LANG(?ru) = "ru")
  FILTER NOT EXISTS { ?item wdt:P31 wd:Q174782 }
  OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en) = "en") }
  OPTIONAL { ?item p:P625/psv:P625 [ wikibase:geoLatitude ?lat; wikibase:geoLongitude ?lon ] }
  OPTIONAL { ?item wdt:P1566 ?gn }
  OPTIONAL { ?item wdt:P131 ?located }
  OPTIONAL { ?located wdt:P300 ?iso FILTER(STRSTARTS(?iso, "RU-")) }
}

# Parent hop for streets whose P131 is a district not in curated cities/regions.
