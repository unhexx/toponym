#   VALUES ?city { wd:Q894 wd:Q887 }
#   ?city wdt:P131 ?item .
#   ?item wdt:P31/wdt:P279* wd:Q13626398 .
#   OPTIONAL { ?item rdfs:label ?ru FILTER(LANG(?ru) = "ru") }
#   OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en) = "en") }
#   OPTIONAL { ?item wdt:P764 ?oktmo }
#   OPTIONAL { ?item wdt:P131/wdt:P300 ?iso FILTER(STRSTARTS(?iso, "RU-")) }
