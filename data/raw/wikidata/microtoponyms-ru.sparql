# Microtoponyms in Russia from Wikidata, CC0.
# P31: урочище Q1434274 / Q125505344, овраг Q1361400, поле Q188869,
# cave Q35509, park Q22698. P17 = Russia (Q159).
# Wikidata parks+caves+овраг+урочище+поле, not GKGN.
# Do not vendor SPARQL JSON/CSV.
# Excluded: forest Q4421 (bulk), ravine/gorge Q2042028 (oronym overlap).

SELECT DISTINCT ?item ?ru ?en ?lat ?lon ?gn ?located ?iso WHERE {
  VALUES ?type { wd:Q1434274 wd:Q125505344 wd:Q1361400 wd:Q188869 wd:Q35509 wd:Q22698 }
  ?item wdt:P31 ?type .
  ?item wdt:P17 wd:Q159 .
  ?item rdfs:label ?ru FILTER(LANG(?ru) = "ru")
  OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en) = "en") }
  OPTIONAL { ?item p:P625/psv:P625 [ wikibase:geoLatitude ?lat; wikibase:geoLongitude ?lon ] }
  OPTIONAL { ?item wdt:P1566 ?gn }
  OPTIONAL { ?item wdt:P131 ?located }
  OPTIONAL { ?located wdt:P300 ?iso FILTER(STRSTARTS(?iso, "RU-")) }
}

# Parent hop for items whose P131 is not in curated cities/municipalities/regions.
