# Municipal formations of Russia from Wikidata, CC0.
# P31 in mapped types. P17 = Russia (Q159).
# Coverage is Wikidata only — not OKTMO/GAR and not every МО of Russia.
# seed_municipalities.py runs this once per VALUES type. Do not vendor SPARQL JSON/CSV.

SELECT DISTINCT ?item ?type ?ru ?en ?lat ?lon ?gn ?oktmo ?located ?iso ?dissolved ?replaced WHERE {
  VALUES ?type {
    wd:Q13626398 wd:Q3350075 wd:Q2198484 wd:Q60849925
    wd:Q27587207 wd:Q2661988 wd:Q634099
  }
  ?item wdt:P31 ?type .
  ?item wdt:P17 wd:Q159 .
  ?item rdfs:label ?ru FILTER(LANG(?ru) = "ru")
  OPTIONAL { ?item rdfs:label ?en FILTER(LANG(?en) = "en") }
  OPTIONAL { ?item p:P625/psv:P625 [ wikibase:geoLatitude ?lat; wikibase:geoLongitude ?lon ] }
  OPTIONAL { ?item wdt:P1566 ?gn }
  OPTIONAL { ?item wdt:P764 ?oktmo }
  OPTIONAL { ?item wdt:P131 ?located }
  OPTIONAL { ?located wdt:P300 ?iso FILTER(STRSTARTS(?iso, "RU-")) }
  OPTIONAL { ?item wdt:P576 ?dissolved }
  OPTIONAL { ?item wdt:P1366 ?replaced }
}

# Parent hop for items whose P131 is not in curated municipalities/regions.
# scripts/seed_municipalities.py подставляет VALUES ?item { wd:Q… }. Не гонять без VALUES.
# SELECT DISTINCT ?item ?subj ?iso WHERE {
#   VALUES ?item { wd:Q13626398 }
#   ?item wdt:P131* ?subj .
#   ?subj wdt:P300 ?iso .
#   FILTER(STRSTARTS(?iso, "RU-"))
# }

