{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unhexx/toponym/schema/catalog.schema.json",
  "title": "toponym source catalog",
  "type": "object",
  "required": ["updated", "sources"],
  "additionalProperties": false,
  "properties": {
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "watchlist_github": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "$defs": {
    "detector": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["http_head", "http_dated", "github_commits", "page_fingerprint", "none"]
        },
        "urls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repo": { "type": "string" },
        "since": { "type": "string" },
        "also": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "license", "vendor", "checked_at", "detector"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "license": { "type": "string", "minLength": 2 },
        "vendor": { "type": "boolean" },
        "max_vendor_bytes": { "type": "integer", "minimum": 0 },
        "checked_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "cursor": { "type": "string" },
        "last_updated": { "type": "string" },
        "detector": { "$ref": "#/$defs/detector" }
      }
    }
  }
}
