{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/unhexx/toponym/schema/mapping.schema.json",
  "title": "source field mapping to canonical record",
  "type": "object",
  "required": ["source_id", "stable_id", "fields", "delete_policy"],
  "additionalProperties": false,
  "properties": {
    "source_id": { "type": "string", "minLength": 2 },
    "stable_id": { "type": "string", "minLength": 2 },
    "fields": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "class_map": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "filter": {
      "type": "object",
      "additionalProperties": true
    },
    "delete_policy": {
      "type": "string",
      "enum": ["deprecate", "ignore", "pointer"]
    },
    "notes": { "type": "string" }
  }
}
